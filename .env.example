# =============================================================================
# ShopMetric configuration. Copy to .env (./shopmetric.sh up does this for you).
# Default = LOCAL mode: everything runs in Docker, no accounts or keys needed.
# =============================================================================

# FULL mode (needs ~5 GB of RAM for Docker). On an 8 GB laptop use .env.laptop instead:
#   ./shopmetric.sh mode laptop
# Optional services: local = Postgres, s3local = SeaweedFS (S3), ui = Kafka UI.
# Set to empty for CLOUD mode (real AWS S3 + Snowflake, see the bottom of this file).
COMPOSE_PROFILES=local,s3local,ui

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HEAP_OPTS=-Xms256m -Xmx1g
TOPIC_ORDERS=orders.raw
TOPIC_ALERTS=orders.fraud_alerts
ALERTS_ENABLED=true
# Orders per second (5/s ~= 432k orders/day)
PRODUCER_RATE=5

# --- Lake: S3-compatible object storage (SeaweedFS locally) ---------------------
LAKE_URI=s3a://shopmetric-lake
S3_ENDPOINT=http://seaweedfs:8333
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=shopmetric
AWS_SECRET_ACCESS_KEY=shopmetric-secret

# --- Warehouse ----------------------------------------------------------------
WAREHOUSE=postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=shopmetric
PG_USER=shopmetric
PG_PASSWORD=shopmetric
PG_READER_USER=shopmetric_reader
PG_READER_PASSWORD=reader

# --- Spark streaming ------------------------------------------------------------
TRIGGER_INTERVAL=1 second
BRONZE_TRIGGER_INTERVAL=30 seconds
MAX_OFFSETS_PER_TRIGGER=20000
STARTING_OFFSETS=earliest
VELOCITY_WINDOW_S=600
STATE_IDLE_TIMEOUT_MIN=30
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=4
TRAIN_DRIVER_MEMORY=2g
# true = './shopmetric.sh train' pauses the stream while training (low-RAM laptops)
LOW_MEMORY=false
CHECKPOINT_DIR=/checkpoints

# --- Model ---------------------------------------------------------------------
MODEL_DIR=/models/fraud
MODEL_RELOAD_S=30

# --- Dashboard + AI copilot (optional) ------------------------------------------
DASHBOARD_REFRESH_S=5
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-haiku-5-5

# =============================================================================
# CLOUD MODE (AWS S3 + Snowflake) - see README "Cloud mode". Uncomment and fill:
# =============================================================================
# COMPOSE_PROFILES=
# LAKE_URI=s3a://<your-unique-bucket-name>
# S3_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<iam access key>
# AWS_SECRET_ACCESS_KEY=<iam secret key>
# WAREHOUSE=snowflake
# SNOWFLAKE_ACCOUNT=<orgname-accountname>
# SNOWFLAKE_USER=SHOPMETRIC_SVC
# SNOWFLAKE_PRIVATE_KEY_FILE=/secrets/snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_ROLE=SHOPMETRIC_WRITER
# SNOWFLAKE_READER_ROLE=SHOPMETRIC_READER
# SNOWFLAKE_WAREHOUSE=SHOPMETRIC_WH
# SNOWFLAKE_DATABASE=SHOPMETRIC
# SNOWFLAKE_SCHEMA=ANALYTICS
# Fewer dashboard queries = fewer Snowflake credits
# DASHBOARD_REFRESH_S=30
