# =============================================================================
# ShopMetric LAPTOP mode - tuned for an 8 GB RAM laptop (Docker/WSL limited to ~4 GB).
# Same pipeline, same code: real Apache Kafka, Spark Structured Streaming, MLlib, Postgres,
# Streamlit. Differences from full mode:
#   - the lake is a local folder (/lake) instead of the SeaweedFS S3 server
#   - no Kafka UI container (inspect topics with ./shopmetric.sh topics)
#   - smaller memory for Kafka and Spark, 2 CPU cores, a 2-second micro-batch trigger
#   - './shopmetric.sh train' pauses the stream while the model trains
# Measured: Spark stream ~1.4 GB, dashboard ~0.2 GB, Postgres+producer ~0.2 GB; Kafka ~0.6 GB (est.).
# Switch back with: ./shopmetric.sh mode full
# =============================================================================

COMPOSE_PROFILES=local

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
TOPIC_ORDERS=orders.raw
TOPIC_ALERTS=orders.fraud_alerts
ALERTS_ENABLED=true
# Orders per second (5/s ~= 432k orders/day)
PRODUCER_RATE=5

# --- Lake: a local folder inside Docker (same parquet layout as on S3) ------------
LAKE_URI=file:///lake
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Warehouse ----------------------------------------------------------------
WAREHOUSE=postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=shopmetric
PG_USER=shopmetric
PG_PASSWORD=shopmetric
PG_READER_USER=shopmetric_reader
PG_READER_PASSWORD=reader

# --- Spark streaming ------------------------------------------------------------
TRIGGER_INTERVAL=2 seconds
BRONZE_TRIGGER_INTERVAL=60 seconds
MAX_OFFSETS_PER_TRIGGER=20000
STARTING_OFFSETS=earliest
VELOCITY_WINDOW_S=600
STATE_IDLE_TIMEOUT_MIN=30
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=768m
SPARK_DRIVER_JAVA_OPTS=-XX:+UseSerialGC
SPARK_SHUFFLE_PARTITIONS=2
TRAIN_DRIVER_MEMORY=1g
# true = './shopmetric.sh train' pauses the stream while training (low-RAM laptops)
LOW_MEMORY=true
CHECKPOINT_DIR=/checkpoints

# --- Model ---------------------------------------------------------------------
MODEL_DIR=/models/fraud
MODEL_RELOAD_S=30

# --- Dashboard + AI copilot (optional) ------------------------------------------
DASHBOARD_REFRESH_S=10
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-haiku-5-5

# =============================================================================
# CLOUD MODE (AWS S3 + Snowflake) - see README "Cloud mode". Uncomment and fill:
# =============================================================================
# COMPOSE_PROFILES=
# LAKE_URI=s3a://<your-unique-bucket-name>
# S3_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<iam access key>
# AWS_SECRET_ACCESS_KEY=<iam secret key>
# WAREHOUSE=snowflake
# SNOWFLAKE_ACCOUNT=<orgname-accountname>
# SNOWFLAKE_USER=SHOPMETRIC_SVC
# SNOWFLAKE_PRIVATE_KEY_FILE=/secrets/snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_ROLE=SHOPMETRIC_WRITER
# SNOWFLAKE_READER_ROLE=SHOPMETRIC_READER
# SNOWFLAKE_WAREHOUSE=SHOPMETRIC_WH
# SNOWFLAKE_DATABASE=SHOPMETRIC
# SNOWFLAKE_SCHEMA=ANALYTICS
# Fewer dashboard queries = fewer Snowflake credits
# DASHBOARD_REFRESH_S=30
